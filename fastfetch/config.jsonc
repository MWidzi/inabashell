{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/ascii-clean.txt",
        "width": null,
        "height": 14,
        "padding": {
            "top": 1,
            "left": 5,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#c7c7c7",
            "separator": "#c7c7c7"
        },
        "brightColor": true,
        "key": {
            "width": 0,
            "type": "icon",
            "paddingLeft": 0 
        },
        "bar": {
            "char": {
                "elapsed": "■",
                "total": "-"
            },
            "border": {
                "left": "[ ",
                "right": " ]",
                "leftElapsed": "",
                "rightElapsed": ""
            },
            "color": {
                "elapsed": "auto",
                "total": "97",
                "border": "97"
            },
            "width": 10
        },
        "percent": {
            "type": 2, 
            "color": {
                "green": "#1184a3",
                "yellow": "#526e7b",
                "red": "#923852"
            }
        },
        "constants": [
            "\u001b[38;2;199;199;199m                             │\u001b[30D\u001b[39m",
        ]
    },
    "general": {
        "thread": true,
        "processingTimeout": 5000,
        "detectVersion": true,
        "playerName": "",
        "dsForceDrm": false
    },
    "modules": [ 
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;199;199;199m╭────────\u001b[0m"
        },
        {
            "type": "os",
            "keyIcon": "│ \u001b[38;2;245;149;159m\u001b[0m",
            "format": "{name}"
        },
        {
            "type": "wm",
            "keyIcon": "│ \u001b[38;2;233;82;116m\u001b[0m",
            "detectPlugin": false,
            "format": "{pretty-name}"
        },
        {
            "type": "packages",
            "keyIcon": "│ \u001b[38;2;233;82;116m󰏖\u001b[0m",
            "disabled": [
                "apk"
            ],
            "combined": false,
            "format": "{all} pkgs"
        },
        {
            "type": "shell",
            "keyIcon": "│ \u001b[38;2;232;79;86m\u001b[0m",
            "format": "{process-name}"
        },
        {
            "type": "editor",
            "keyIcon": "│ \u001b[38;2;162;69;68m\u001b[0m",
            "format": "{$1}{Name}"
        },
        {
            "type": "host",
            "keyIcon": "│ \u001b[38;2;196;201;252m󰌢\u001b[0m",
            "format": "{$1}{name}"
        },
        {
            "type": "uptime",
            "keyIcon": "│ \u001b[38;2;196;201;252m\u001b[0m",
            "format": "{$1}{hours} hours, {minutes} mins"
        },
        {
            "type": "cpu",
            "keyIcon": "  \u001b[38;2;143;182;232m\u001b[0m",
            "temp": false,
            "showPeCoreCount": false,
            "format": "{$1}{name} @ {freq-max}"
        },
        {
            "type": "gpu",
            "keyIcon": "  \u001b[38;2;143;182;232m󰾲\u001b[0m",
            "driverSpecific": false,
            "detectionMethod": "pci",
            "temp": false,
            "hideType": "none",
            "percent": {
                "green": 50,
                "yellow": 80,
                "type": 0
            },
            "format": "{$1}{name}"
        },
        {
            "type": "memory",
            "keyIcon": "  \u001b[38;2;244;209;119m\u001b[0m",
            "percent": {
                "green": 50,
                "yellow": 80,
                "type": 0
            },
            "format": "{$1}{used} / {total}"
        },
        {
            "type": "disk",
            "keyIcon": "  \u001b[38;2;246;222;41m\u001b[0m",
            "showRegular": true,
            "showExternal": true,
            "showHidden": false,
            "showSubvolumes": false,
            "showReadOnly": true,
            "showUnknown": false,
            "folders": "",
            "hideFolders": "/efi:/boot:/boot/*",
            "hideFS": "",
            "useAvailable": false,
            "percent": {
                "green": 50,
                "yellow": 80,
                "type": 0
            },
            "format": "{$1}{size-used} / {size-total}"
        }, 
        {
            "type": "custom",
            "format": "                          \u001b[38;2;199;199;199m────────╯\u001b[0m"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 10
        }
    ]
}
